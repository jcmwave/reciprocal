from typing import Any

from reciprocal.sampling import PointCounts, SamplingConstraint

from .content_symmetry import ContentSymmetry, SymmetryCone
from .domains import KDomain
from .model import CartesianGrid, CircularGrid, KSampling, PolarGrid

SpectrumGrid = CartesianGrid | CircularGrid | PolarGrid
class NonPeriodicSampler:
    def sample(self, domain: KDomain, grid: SpectrumGrid | PointCounts | str = ..., *, include_cells: bool = ..., constraint: SamplingConstraint = ..., content_symmetry: ContentSymmetry | str | None = ..., symmetry_cone: SymmetryCone | tuple[float, float] | str | None = ..., adapt_symmetry: bool = ...) -> KSampling: ...
    def sample_cartesian(self, domain: KDomain, grid: CartesianGrid, *, include_cells: bool = ...) -> KSampling: ...
    def sample_circular(self, domain: KDomain, grid: CircularGrid, *, include_cells: bool = ..., angular_multiple: int = ..., angular_offset: float = ...) -> KSampling: ...
    def sample_polar(self, domain: KDomain, grid: PolarGrid, *, include_cells: bool = ..., angular_offset: float = ...) -> KSampling: ...
def resolve_sampling_grid(domain: KDomain, scheme: str, constraint: SamplingConstraint = ...) -> SpectrumGrid: ...
def grid_from_constraint(domain: KDomain, constraint: SamplingConstraint, *, default: int = ...) -> CartesianGrid: ...
def voronoi_physical_weights(points: Any, domain: KDomain) -> Any: ...
